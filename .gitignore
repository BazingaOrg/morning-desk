# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated reports
/data/reports
/data/cache
/data/latest.json
/data/state.json
/data/status.json
/data/locks
/data/runs
/data/snapshots

# short-monitor run artifacts (keep security-master, tools, positions, fixtures, prompts)
/data/short-monitor/runs
/data/short-monitor/latest.json
/data/short-monitor/state.json
